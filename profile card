<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile Card</title>
<style>
  
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #f7a1c4, #c084fc);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Poppins', sans-serif;
    }

    .card {
      background: white;
      width: 350px;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
      text-align: center;
      position: relative;
    }

    .card-header {
      height: 150px;
      width: 100%;
      background: url('https://source.unsplash.com/350x150/?ant') center/cover no-repeat;
      position: relative;
    }

    .profile-pic {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: white;
      padding: 10px;
      position: absolute;
      bottom: -50px;
      left: 50%;
      transform: translateX(-50%);
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .profile-pic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    .card-body {
      padding: 60px 20px 20px;
    }

    .card-body h2 {
      font-size: 22px;
      color: #333;
      margin-bottom: 5px;
      font-weight: 600;
    }

    .card-body p.job {
      font-size: 14px;
      color: #888;
      margin-bottom: 20px;
    }

    .card-stats {
      display: flex;
      justify-content: center;
      gap: 30px;
      margin-bottom: 20px;
    }

    .card-stats div {
      text-align: center;
    }

    .card-stats div h3 {
      font-size: 18px;
      color: #3498db;
      margin-bottom: 5px;
    }

    .card-stats div p {
      font-size: 12px;
      color: #aaa;
    }

    .follow-btn {
      background: #f7c32e;
      color: black;
      font-weight: bold;
      padding: 10px 30px;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: background 0.3s ease;
      margin-bottom: 20px;
    }

    .follow-btn:hover {
      background: #f4b400;
    }

    .card-footer {
      padding: 0 20px 20px;
      font-size: 13px;
      color: #555;
      line-height: 1.4;
    }

    /* 3 dots menu */
    .menu {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 4px;
      height: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
    }

    .menu div {
      width: 4px;
      height: 4px;
      background-color: #555;
      border-radius: 50%;
    }
</style>

</head>

<body>

  <div class="card">
    <div class="card-header">
      <div class="profile-pic">
        <img src="https://cdn-icons-png.flaticon.com/512/147/147144.png" alt="Profile Picture">
      </div>
      <div class="menu">
        <div></div>
        <div></div>
        <div></div>
      </div>
    </div>
    <div class="card-body">
      <h2>Ali Shaikh</h2>
      <p class="job">Ant Collector</p>
      <div class="card-stats">
        <div>
          <h3>12</h3>
          <p>Followers</p>
        </div>
        <div>
          <h3>1000</h3>
          <p>Following</p>
        </div>
      </div>
      <button class="follow-btn">Follow</button>
    </div>
    <div class="card-footer">
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Corporis, ut omnis.
    </div>

</body>

</html>
